# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_ME

# ── Service endpoints ─────────────────────────────────────────────────────────
META_OS_API=http://127.0.0.1:8000
OBSERVER_URL=http://localhost:8081

# ── API auth (set a strong secret — leave blank to disable auth in dev) ───────
META_OS_API_KEY=REPLACE_ME

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/meta-os

# ── Memory / ChromaDB ─────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma

# ── Anthropic (optional — for CrewAI fallback to Claude) ─────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
