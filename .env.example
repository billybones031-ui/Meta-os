# ── Claude Pro ───────────────────────────────────────────────────────
# No API key needed. Authenticate once: claude auth login
CLAUDE_CLI_PATH=claude

# ── Gemini Advanced ──────────────────────────────────────────────────
# No API key needed. Authenticate once: gemini auth login
GEMINI_CLI_PATH=gemini

# ── Ollama (local on Chromebook, zero cost) ───────────────────────────
# From Pixel SSH tunnel: ssh -L 11434:localhost:11434 user@chromebook
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Telegram ─────────────────────────────────────────────────────────
# Token from @BotFather. Your user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789

# ── Database ─────────────────────────────────────────────────────────
# AES-256 field encryption. Set a strong passphrase and keep it safe.
DB_PASSPHRASE=change_this_to_something_strong

# Cross-device: Chromebook = master. Pixel = replica + offline queue.
# On Chromebook set: IS_DB_MASTER=true
# On Pixel set:      IS_DB_MASTER=false, DB_MASTER_HOST=<chromebook tunnel url>
IS_DB_MASTER=false
DB_MASTER_HOST=http://localhost:8001

# ── Cloudflare Named Tunnel (free) ────────────────────────────────────
# Setup: cloudflared tunnel create meta-os
# Token: cloudflared tunnel token meta-os
CLOUDFLARE_TUNNEL_TOKEN=

# ── GitHub (free PAT for MCP server) ─────────────────────────────────
# Generate at: github.com/settings/tokens  Scopes: repo, read:org
GITHUB_PAT=

# ── Workspaces ───────────────────────────────────────────────────────
DEFAULT_WORKSPACE=personal
BUSINESS_WORKSPACE=business

# ── Ports ────────────────────────────────────────────────────────────
DASHBOARD_PORT=7860
DB_SYNC_PORT=8001
MCP_PORT_LITE=8081
MCP_PORT_FULL=8080
